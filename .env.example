# Pantarr settings (docker compose reads this file). Only the first block is required.

# ── Required ──
PANTARR_SECRET=change-me-to-a-random-string-of-32-characters-or-more   # cookies and encryption of the stored secrets: keep it safe, changing it makes them unreadable
POSTGRES_PASSWORD=change-me
PANTARR_BASE_URL=http://localhost:9925                                  # public address, without a trailing slash (OAuth and e-mail links)

# ── First start ──
# First administrator (otherwise the first visit asks for it)
PANTARR_ADMIN_EMAIL=
PANTARR_ADMIN_PASSWORD=
PANTARR_DEFAULT_LOCALE=en                                               # en | fr
PANTARR_SESSION_DAYS=30

# ── Behind a reverse proxy ──
# Proxies trusted for the client's address. Empty: the proxy in front (private address) and Cloudflare.
# PANTARR_TRUST_PROXY=1
# Pages allowed to show Pantarr in a frame (e.g. a home dashboard): CSP frame-ancestors values, space separated
# PANTARR_FRAME_ANCESTORS='self' https://dashboard.example.com
# Limits on sign-in, sign-up, password e-mails… (« off » for tests only)
# PANTARR_RATE_LIMIT=on
# Bug reports and feature requests: GitHub repository whose issue forms the menu opens prefilled (« off » hides them)
# PANTARR_ISSUES_URL=https://github.com/trunckz/pantarr
# PANTARR_ISSUES_TOKEN=                # fine-grained GitHub token, Issues: write on that repository: the menu then opens
#                                       # a form in the app (no GitHub account needed) ; the tickets are public

# ── Outgoing mail (sign-up check, invitations, forgotten password ; without it the links are only logged) ──
# PANTARR_SMTP_URL=smtp://user:password@smtp.example.com:587
# PANTARR_MAIL_FROM=Pantarr <no-reply@example.com>

# ── « Connect with Google / Microsoft / Todoist » in one click (instance OAuth clients ; redirect address:
#    <PANTARR_BASE_URL>/api/v1/oauth/callback and, for sign-in, <PANTARR_BASE_URL>/api/v1/auth/social/callback) ──
# PANTARR_GOOGLE_CLIENT_ID=
# PANTARR_GOOGLE_CLIENT_SECRET=
# PANTARR_MICROSOFT_CLIENT_ID=          # add the optional claim xms_edov to the ID token (docs/hosted.md)
# PANTARR_MICROSOFT_CLIENT_SECRET=
# PANTARR_TODOIST_CLIENT_ID=
# PANTARR_TODOIST_CLIENT_SECRET=

# ── Receipts forwarded by e-mail (an address per household on this domain ; deploy/cloudflare/inbound-worker.js) ──
# PANTARR_INBOUND_DOMAIN=receipts.example.com
# PANTARR_INBOUND_SECRET=               # shared with the mail worker (Bearer)

# ── Browser extension published in the stores (otherwise downloaded from the instance) ──
# PANTARR_EXTENSION_CHROME_URL=
# PANTARR_EXTENSION_FIREFOX_URL=

# ── Public pages /privacy and /terms (required to publish a Google app) ──
# PANTARR_OPERATOR_NAME=
# PANTARR_CONTACT_EMAIL=
# PANTARR_LEGAL_UPDATED=2026-11-06

# ── Extra connectors (plugins), self-hosted only: docs/connectors.md ──
# PANTARR_CONNECTORS_DIR=/connectors

# ── Hosted offer (docs/hosted.md): sign-up, shared Mealie, platform LLM, plans and billing ──
# PANTARR_MODE=hosted
# PANTARR_SIGNUP=open                   # open | code (invitation codes) | closed
# PANTARR_MEALIE_URL=http://mealie:9000
# PANTARR_MEALIE_ADMIN_TOKEN=
# PANTARR_PLATFORM_GEMINI_KEY=
# PANTARR_PLATFORM_GEMINI_MODEL=gemini-flash-latest
# PANTARR_PLANS=[{"code":"family","name":"Family","price":"4 €/month","llmMonthlyCalls":48,"maxAccounts":6,"priceId":"pri_…"}]
# PANTARR_BILLING=paddle                # paddle | stripe
# PANTARR_BILLING_WEBHOOK_SECRET=
# PANTARR_PADDLE_CLIENT_TOKEN=
# PANTARR_PADDLE_ENV=sandbox
# PANTARR_PADDLE_API_KEY=
# PANTARR_STRIPE_SECRET_KEY=
